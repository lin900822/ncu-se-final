@startuml component
title 房間建立、加入、階段同步與題目表單 - 組件圖
actor 老師
actor 學生
component "老師端畫面" as TUI
component "學生端畫面" as SUI
package "後端" {
  component "房間服務\n(代碼產生/驗證\n老師憑證與恢復碼)" as RoomSvc
  component "組別服務\n(組名正規化/唯一性\n在線時拒絕重複加入)" as GroupSvc
  component "學習單服務\n(驗證連結/讀取試算表\n依表頭辨識單題/題組\n驗證題號連續且不重複\n產生指紋)" as SheetSvc
  component "階段服務\n(開始/結束搶答\n老師憑證驗證\n階段為唯一事實來源)" as PhaseSvc
  component "房間逾時排程\n(閒置2小時自動結束)" as Expiry
  component "即時廣播通道" as Realtime
  database "房間狀態儲存" as Store
}
file ".env\nGOOGLE_SERVICE_ACCOUNT_FILE" as Env
file "服務帳號 JSON 金鑰\n(不入版控)" as Key
cloud "Google Sheet" as Sheets
老師 --> TUI
學生 --> SUI
TUI --> SheetSvc : 貼上連結預覽題號\n(確認後才建立房間)
SheetSvc --> RoomSvc : 驗證通過才建立房間(含題目)
SheetSvc --> Env : 啟動時讀取路徑
Env ..> Key
SheetSvc --> Sheets : 以機器人身分唯讀讀取(只讀scope)
SUI --> RoomSvc : 取得題號清單(加入/重連)
TUI --> PhaseSvc : 開始/結束搶答
PhaseSvc --> RoomSvc : 驗證老師憑證/房間開放
PhaseSvc --> Store : 追加階段紀錄
PhaseSvc --> Realtime : 階段變更事件(不含作答內容)
Realtime --> SUI : 階段(解鎖/鎖定)
TUI --> RoomSvc : 建立/結束房間\n以憑證或恢復碼回復
SUI --> GroupSvc : 以代碼+組名加入
GroupSvc --> RoomSvc : 驗證房間開放\n更新最後活動時間
RoomSvc --> Store
GroupSvc --> Store
Expiry --> RoomSvc : 結束閒置房間
Expiry --> Store : 掃描最後活動時間
GroupSvc --> Realtime : 組別變更事件
Realtime --> TUI : 即時組別清單
@enduml
